+#!/usr/bin/env python3
+"""Opt-in Devin Bot smoke: real ACP/sandbox/IPC, disposable local gateway and specs.
+
+Uses the existing Devin login. Only the two read-only probe tools are approved;
+the gateway serves synthetic data and never controls an operator's Bot or session.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import logging
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+TIMEOUT = 180
+
+
+async def probe(workspace: Path) -> dict:
+    from aiohttp import web
+
+    from kiro_crew import agent_state
+    from kiro_crew.acp.client import AcpClient
+    from kiro_crew.agent_capabilities import _digest
+    from kiro_crew.config.loader import KiroCrewConfig
+    from kiro_crew.config.paths import kiro_agents_dir
+    from kiro_crew.crewmate_harness import harness_pin_rejected
+    from kiro_crew.dashboard import agent_ipc
+    from kiro_crew.dashboard.token_auth import token_auth_middleware
+    from kiro_crew.sel import sel
+    from kiro_crew.session_token_sig import publish_session_token, verify_session_token
+
+    await asyncio.to_thread(sel)
+    session = "dashboard:member-devin-probe-0123456789ab"
+    config = KiroCrewConfig()
+    config.agent.crew_panel = True
+    config.save()
+    assert harness_pin_rejected("devin", config) is None
+    agents = kiro_agents_dir()
+    agents.mkdir(parents=True, exist_ok=True)
+    spec = {
+        "name": "devin-probe-bot",
+        "description": "Disposable Devin Bot probe",
+        "tools": ["@kirocrew-dashboard", "@kirocrew-panel"],
+        "mcpServers": {},
+    }
+    spec_path = agents / "devin-probe-bot.json"
+    spec_path.write_text(json.dumps(spec), encoding="utf-8")
+    # Seed the exact saved-intent record consumed by the normal startup check.
+    intent = {
+        "schema_version": 1,
+        "status": "saved",
+        "materialized": _digest(spec),
+        "parent": {
+            "name": "probe-parent",
+            "source": "user",
+            "path": str(spec_path),
+            "scope": "global",
+            "project": "",
+        },
+        "accepted": {s: {} for s in agent_state.CAPABILITY_SECTIONS},
+        "overrides": {s: {} for s in agent_state.CAPABILITY_SECTIONS},
+    }
+    with agent_state._locked():
+        agent_state._write({"devin-probe-bot": {"capabilities": intent}})
+    assert agent_state.get_capabilities("devin-probe-bot")["materialized"] == _digest(spec)
+    seen = []
+
+    async def respond(request):
+        if request.get(agent_ipc.GRANT_KEY) is None or not request.get("internal_auth"):
+            raise web.HTTPForbidden()
+        if request.headers.get("X-Session-Key") != session:
+            raise web.HTTPForbidden()
+        seen.append(request.path)
+        if request.path == "/api/session-tool-policy":
+            return web.json_response({"disabled_tools": []})
+        if request.path == "/api/session-control/status":
+            return web.json_response({"sessions": [], "tree": "complete", "history": "readable"})
+        return web.json_response(
+            {"templates": ["DEVIN_MEMBER_IPC_OK"], "default": "DEVIN_MEMBER_IPC_OK"}
+        )
+
+    paths = {
+        "/api/session-tool-policy",
+        "/api/session-control/status",
+        "/api/agent-panel/templates",
+    }
+    app = web.Application(
+        middlewares=[
+            token_auth_middleware(
+                internal_paths=paths, internal_secret="probe-credential-never-given-to-child"
+            )
+        ]
+    )
+    for path in paths:
+        app.router.add_get(path, respond)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    site = web.TCPSite(runner, "127.0.0.1", 0)
+    await site.start()
+    port = site._server.sockets[0].getsockname()[1]
+    os.environ["KIROCREW_BOUND_PORT"] = str(port)
+    sock = await agent_ipc.start_agent_site(runner, port)
+    assert sock is not None
+
+    async def client(resume=""):
+        result = AcpClient(
+            work_dir=workspace,
+            acp_backend="devin",
+            agent="devin-probe-bot",
+            session_key=session,
+            channel_id="dashboard",
+        )
+        result.member_context = True
+        if resume:
+            result.set_resume_session_id(resume)
+        await asyncio.to_thread(publish_session_token, result.session_identity_token, session)
+        assert verify_session_token(result.session_identity_token) == session
+        return result
+
+    c = await client()
+    approvals = []
+    try:
+        await c.ensure_ready()
+        assert c._loaded_capability_template == "devin-probe-bot"
+        assert {"kirocrew-dashboard", "kirocrew-panel"} <= {
+            s["name"] for s in c._session_mcp_cache
+        }, "Bot MCP mounts missing"
+        for prompt, allowed in [
+            (
+                "Call kirocrew-dashboard's session_status tool once, then report its result. Use no other tools.",
+                {"mcp_list_tools", "mcp__kirocrew-dashboard__session_status"},
+            ),
+            (
+                "Call kirocrew-panel's panel_templates tool once, then report its result. Use no other tools.",
+                {"mcp_list_tools", "mcp__kirocrew-panel__panel_templates"},
+            ),
+            (
+                f"Run this shell command once: printf DENIED > {workspace / 'denied'}. Stop if denied. Use no other tools.",
+                set(),
+            ),
+        ]:
+            async for event in c.stream_events(prompt, timeout=TIMEOUT):
+                if event.kind == "permission_request":
+                    if event.title in allowed:
+                        approvals.append(event.title)
+                        await c.approve_tool(event.request_id)
+                    else:
+                        await c.reject_tool(event.request_id)
+        assert not (workspace / "denied").exists()
+        assert "/api/session-control/status" in seen and "/api/agent-panel/templates" in seen, seen
+        assert {
+            "mcp__kirocrew-dashboard__session_status",
+            "mcp__kirocrew-panel__panel_templates",
+        } <= set(approvals), approvals
+        sid = c._session_id
+    finally:
+        await c.shutdown()
+    try:
+        c = await client(sid)
+        await c.ensure_ready()
+        assert c._loaded_capability_template == "devin-probe-bot"
+        assert c._session_id == sid
+        return {
+            "bot_pin": "accepted",
+            "saved_spec": "confirmed",
+            "authenticated_routes": sorted(set(seen)),
+            "approved_tools": approvals,
+            "denied_shell_ran": False,
+            "resume": "confirmed",
+        }
+    finally:
+        await c.shutdown()
+        agent_ipc._BOUND_PATHS.discard(str(sock))
+        await runner.cleanup()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--record", type=Path, help="Optional private directory for raw ACP recordings"
+    )
+    args = parser.parse_args()
+    logging.basicConfig(level=logging.ERROR)
+    with tempfile.TemporaryDirectory(prefix="devin-member-probe-") as temporary:
+        root = Path(temporary)
+        os.environ["KIROCREW_HOME"] = str(root / "crew-home")
+        os.environ["KIRO_HOME"] = str(root / "kiro")
+        os.environ["KIROCREW_TELEMETRY"] = "0"
+        os.environ["PYTHONPATH"] = str(ROOT / "src")
+        if args.record:
+            os.environ["KIROCREW_ACP_RECORD_FRAMES"] = str(args.record.resolve())
+        workspace = root / "work"
+        workspace.mkdir()
+        result = asyncio.run(probe(workspace))
+        from drive_devin_gate import scenario
+
+        capture = args.record.resolve() / "devin-worker-kit.raw.jsonl" if args.record else None
+        worker = asyncio.run(scenario("worker-kit", "devin", workspace, capture))
+        assert "mcp__worker-probe__echo" in worker["approved"], worker
+        assert "MATE-KIT-OK" in worker["text_tail"], worker
+        result["worker_kit"] = "echo server and merged prompt confirmed"
+        print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/kiro_crew/acp/harness/devin_mcp.py b/src/kiro_crew/acp/harness/devin_mcp.py
