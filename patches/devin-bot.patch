+++ b/test/test_devin_member_ipc.py
@@ -0,0 +1,55 @@
+"""Devin's managed servers keep credentials process-bound and session-scoped."""
+
+import sys
+from unittest.mock import Mock
+
+import pytest
+import test_agent_ipc_client as ipc_tests
+from test_agent_ipc_client import _env, _issue, _Runtime
+
+from kiro_crew.acp.harness import devin_mcp
+from kiro_crew.agent_ipc_wire import PICKUP_ENV
+
+bound_fixture = ipc_tests.bound
+
+
+@pytest.mark.parametrize(
+    "name", ["kirocrew-core", "kirocrew-cron", "kirocrew-dashboard", "kirocrew-panel"]
+)
+def test_devin_managed_servers_get_a_trusted_entry_and_session_pickup(bound_fixture, name):
+    runtime = _Runtime()
+    original = {"name": name, "command": "untrusted-spec-command", "args": [], "env": []}
+    (entry,) = _issue([original], backend="devin", runtime=runtime)
+    assert entry["command"] == sys.executable
+    assert any(arg.endswith("/devin_mcp.py") for arg in entry["args"])
+    assert entry["args"][-1] == name
+    assert PICKUP_ENV in _env(entry)
+    stored = next(iter(bound_fixture._pickups.values()))
+    assert stored.server == name and stored.session_token == "tok"
+    assert original["command"] == "untrusted-spec-command" and original["env"] == []
+
+
+def test_third_party_server_never_gets_an_ipc_credential(bound_fixture):
+    runtime = _Runtime()
+    original = {"name": "third-party", "command": "x", "args": [], "env": []}
+    assert _issue([original], backend="devin", runtime=runtime) == [original]
+    assert not bound_fixture._pickups
+
+
+def test_devin_wrapper_redeems_before_serving_in_the_same_process(monkeypatch):
+    calls = []
+    monkeypatch.setattr(sys, "argv", ["wrapper", "kirocrew-dashboard"])
+    monkeypatch.setattr(
+        "kiro_crew.agent_ipc_client.redeem_at_startup", lambda port: calls.append("redeemed")
+    )
+    module = Mock()
+    module.run_mcp_server.side_effect = lambda: calls.append("serving")
+    monkeypatch.setattr(devin_mcp.importlib, "import_module", lambda _: module)
+    devin_mcp.main()
+    assert calls == ["redeemed", "serving"]
+
+
+def test_native_other_backend_member_entries_keep_their_launch(bound_fixture):
+    original = {"name": "kirocrew-dashboard", "command": "original", "args": [], "env": []}
+    assert _issue([original], backend="codex") == [original]
+    assert not bound_fixture._pickups
diff --git a/test/test_devin_member_ipc_e2e.py b/test/test_devin_member_ipc_e2e.py
new file mode 100644
index 0000000..65a8650
--- /dev/null
+++ b/test/test_devin_member_ipc_e2e.py
@@ -0,0 +1,138 @@
+"""Bot status and panel calls authenticate through Devin's real OS credential mask."""
+
+import asyncio
+import json
+import os
+import sys
+
+import pytest
+from aiohttp import web
+from test_agent_ipc_enforced_spawn_e2e import _call_through_mask, _src_spellings
+
+from kiro_crew.acp.harness.devin_mcp import prepare_servers
+from kiro_crew.agent_ipc_wire import GATEWAY_PID_ENV, PICKUP_ENV
+from kiro_crew.agent_sdk.tool_gate import adapter_hidden_credential_dirs
+from kiro_crew.dashboard import agent_ipc
+from kiro_crew.dashboard.token_auth import token_auth_middleware
+from kiro_crew.sandbox import SandboxUnavailableError
+from kiro_crew.sandbox_spawn import sandboxed_spawn_argv_async
+from kiro_crew.testing.wait import default_timeout
+
+pytestmark = pytest.mark.skipif(not sys.platform.startswith("linux"), reason="Linux OS mask")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("server", "tool", "route", "answer", "expected"),
+    [
+        (
+            "kirocrew-dashboard",
+            "session_status",
+            "/api/session-control/status",
+            {"sessions": [], "tree": "complete", "history": "readable"},
+            "no sessions",
+        ),
+        (
+            "kirocrew-panel",
+            "panel_templates",
+            "/api/agent-panel/templates",
+            {"templates": ["DEVIN_IPC_OK"], "default": "DEVIN_IPC_OK"},
+            "DEVIN_IPC_OK",
+        ),
+    ],
+)
+async def test_devin_member_tools_reach_authenticated_gateway_under_mask(
+    short_sock_dir, monkeypatch, server, tool, route, answer, expected
+):
+    home = short_sock_dir / "h"
+    home.mkdir()
+    monkeypatch.setenv("KIROCREW_HOME", str(home))
+    monkeypatch.setattr(agent_ipc, "STORE", agent_ipc.CapabilityStore())
+    session = "dashboard:member-devin-0123456789ab"
+    token = "devin-e2e-session-token"
+    monkeypatch.setattr(agent_ipc, "verify_session_token", lambda t: session if t == token else "")
+    seen = []
+
+    async def respond(request):
+        assert request.get("internal_auth") is True
+        assert request.get(agent_ipc.GRANT_KEY) is not None
+        assert request.headers["X-Session-Key"] == session
+        seen.append(request.path)
+        if request.path == "/api/session-tool-policy":
+            return web.json_response({"disabled_tools": []})
+        return web.json_response(answer)
+
+    app = web.Application(
+        middlewares=[
+            token_auth_middleware(
+                internal_paths={route, "/api/session-tool-policy"}, internal_secret="f" * 32
+            )
+        ]
+    )
+    app.router.add_get(route, respond)
+    app.router.add_get("/api/session-tool-policy", respond)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    site = web.TCPSite(runner, "127.0.0.1", 0)
+    await site.start()
+    port = site._server.sockets[0].getsockname()[1]
+    sock = await agent_ipc.start_agent_site(runner, port)
+    try:
+        assert sock is not None
+        entries, _ = prepare_servers([{"name": server, "env": []}])
+        entry = entries[0]
+        env = {
+            "HOME": os.environ.get("HOME", str(home)),
+            "PATH": os.environ.get("PATH", ""),
+            "LANG": "C.UTF-8",
+            "KIROCREW_HOME": str(home),
+            "KIROCREW_BOUND_PORT": str(port),
+            "KIROCREW_STUB_SESSION_TOKEN": token,
+            "PYTHONPATH": os.pathsep.join(_src_spellings()),
+        }
+        (home / "run").mkdir(exist_ok=True)
+        (home / ".local_secret").write_text("f" * 32, encoding="utf-8")
+        try:
+            argv, child_env, _ = await sandboxed_spawn_argv_async(
+                [entry["command"], *entry["args"]],
+                env=env,
+                extra_hidden_dirs=adapter_hidden_credential_dirs("devin"),
+                extra_private_dirs=_src_spellings(),
+            )
+        except SandboxUnavailableError:
+            pytest.skip("OS namespace sandbox unavailable")
+        assert argv != [entry["command"], *entry["args"]], "the test requires the real OS mask"
+        pickup = agent_ipc.issue_pickup(server=server, session_token=token, runtime_pid=os.getpid)
+        child_env.update({PICKUP_ENV: pickup, GATEWAY_PID_ENV: str(os.getpid())})
+        frames = [
+            {
+                "jsonrpc": "2.0",
+                "id": 1,
+                "method": "initialize",
+                "params": {
+                    "protocolVersion": "2025-03-26",
+                    "capabilities": {},
+                    "clientInfo": {"name": "devin-e2e", "version": "1"},
+                },
+            },
+            {"jsonrpc": "2.0", "method": "notifications/initialized"},
+            {
+                "jsonrpc": "2.0",
+                "id": 2,
+                "method": "tools/call",
+                "params": {
+                    "name": tool,
+                    "arguments": {},
+                },
+            },
+        ]
+        payload = b"".join((json.dumps(f) + "\n").encode() for f in frames)
+        reply = await asyncio.wait_for(
+            asyncio.to_thread(_call_through_mask, argv, dict(child_env), payload), default_timeout()
+        )
+        assert expected in reply and "Error:" not in reply, reply
+        assert route in seen
+    finally:
+        if sock is not None:
+            agent_ipc._BOUND_PATHS.discard(str(sock))
+        await runner.cleanup()
