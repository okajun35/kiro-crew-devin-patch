+++ b/test/test_devin_capture_driver.py
@@ -0,0 +1,108 @@
+"""Live capture tooling approves only the fixed probe tools."""
+
+import asyncio
+import importlib.util
+import json
+import shlex
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from kiro_crew import platform_compat
+from kiro_crew.agent_sdk.gate_extensions.devin import bridge as bridge_module
+from kiro_crew.agent_sdk.gate_extensions.devin.bridge import Bridge as GateBridge
+from kiro_crew.testing.wait import default_timeout
+
+
+def _driver():
+    path = Path(__file__).resolve().parents[1] / "scripts/drive_devin_gate.py"
+    spec = importlib.util.spec_from_file_location("isolated_devin_driver", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("allowed", [set(), {"mcp__spec-probe__echo"}])
+async def test_a_capture_never_approves_an_unlisted_shell(tmp_path, allowed):
+    driver = _driver()
+    bridge = driver.Bridge([], tmp_path, approve=allowed)
+    frames = [
+        {
+            "jsonrpc": "2.0",
+            "id": "permission",
+            "method": "session/request_permission",
+            "params": {
+                "toolCall": {"title": "execute_bash"},
+                "options": [
+                    {"kind": "allow_once", "optionId": "allow"},
+                    {"kind": "reject_once", "optionId": "reject"},
+                ],
+            },
+        },
+        {"jsonrpc": "2.0", "id": 1, "result": {}},
+    ]
+
+    class Reader:
+        async def readline(self):
+            return (json.dumps(frames.pop(0)) + "\n").encode()
+
+    sent = []
+
+    async def send(frame):
+        sent.append(frame)
+
+    bridge.process = SimpleNamespace(stdout=Reader(), stdin=object())
+    bridge._send = send
+    await asyncio.wait_for(bridge.request("session/prompt", {}), default_timeout())
+    assert sent[-1]["result"]["outcome"] == {"outcome": "selected", "optionId": "reject"}
+    assert bridge.approved == []
+
+
+def test_bridge_stdin_handles_split_frames_without_a_buffered_stdio_lock(monkeypatch):
+    bridge = GateBridge("binary", "config", "hook", "nonce", "home")
+    chunks = iter([b'{"id":', b'1}\n{"id":2}\n', b""])
+    monkeypatch.setattr(bridge_module, "os", SimpleNamespace(read=lambda *_: next(chunks)))
+    monkeypatch.setattr(
+        bridge_module, "sys", SimpleNamespace(stdin=SimpleNamespace(fileno=lambda: 0))
+    )
+    received = []
+
+    class Loop:
+        def call_soon_threadsafe(self, callback, value):
+            received.append(value)
+
+    bridge.stdin_thread(Loop())
+    assert received == [{"id": 1}, {"id": 2}, None]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("own_hook", [False, True])
+async def test_only_the_exact_own_hook_receipt_is_not_a_model_tool(own_hook):
+    bridge = GateBridge("binary", "config", "/sealed/hook.py", "nonce", "home")
+    bridge.active.add("session")
+    bridge.output = []
+    command = shlex.join(platform_compat.isolated_python_argv("-I", bridge.hook))
+    frame = {
+        "method": "session/update",
+        "params": {
+            "sessionId": "session",
+            "update": {
+                "sessionUpdate": "tool_call",
+                "toolCallId": "hook-display-id",
+                "status": "completed",
+                "_meta": {
+                    "cognition.ai/eventType": "hook_execution",
+                    "cognition.ai/phase": "pre_tool",
+                    "cognition.ai/command": command if own_hook else "untrusted hook",
+                },
+            },
+        },
+    }
+    if own_hook:
+        await asyncio.wait_for(bridge.from_child(frame), default_timeout())
+        assert bridge.output == [] and bridge.approved == set()
+    else:
+        with pytest.raises(RuntimeError, match="without Crew permission"):
+            await asyncio.wait_for(bridge.from_child(frame), default_timeout())
