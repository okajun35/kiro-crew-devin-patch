+"""The Devin array reaches session/new; resolving an array alone proves no delivery."""
+
+import asyncio
+from unittest.mock import AsyncMock, Mock
+
+import pytest
+
+from kiro_crew.acp.client import AcpClient
+from kiro_crew.acp.client_start import _new_session_following_substitution
+from kiro_crew.testing.wait import default_timeout
+
+
+@pytest.mark.asyncio
+async def test_devin_new_session_following_substitution_sends_its_resolved_mcp_array():
+    client = object.__new__(AcpClient)
+    client._acp_backend = "devin"
+    client._launch_mcp_servers = None
+    client._session_mcp_cache = [{"name": "probe", "command": "/probe", "args": []}]
+    client._session_work_dir = AsyncMock(return_value="/workspace")
+    client._pooled_mcp_servers = lambda: []
+    client._begin_session_report = Mock()
+    client._guard_unresolved_mcp_refs = Mock()
+    client._send_request = AsyncMock(return_value=1)
+    client._wait_for_response = AsyncMock(return_value={"sessionId": "devin-session"})
+    await asyncio.wait_for(_new_session_following_substitution(client), default_timeout())
+    client._send_request.assert_awaited_once_with(
+        "session/new", {"cwd": "/workspace", "mcpServers": client._session_mcp_cache}
+    )
