+"""A Devin Bot consumes the saved spec and its worker's own projection."""
+
+import asyncio
+import json
+
+import pytest
+import test_mate_worker_harnesses as worker_tests
+import test_member_mount_devin as mount_tests
+from test_member_mount_devin import MEMBER_KEY, _client
+
+from kiro_crew import agent_state
+from kiro_crew.acp.transport_errors import AcpError
+from kiro_crew.agent_capabilities import _digest, member_backend_gap
+from kiro_crew.config.loader import KiroCrewConfig
+from kiro_crew.crewmate_harness import (
+    crewmate_harnesses,
+    harness_pin_rejected,
+    worker_harnesses,
+)
+
+agents_dir_fixture = mount_tests.agents_dir
+pixel_worker_fixture = worker_tests.pixel_worker
+
+
+def _saved_client(tmp_path):
+    client = _client(tmp_path, MEMBER_KEY)
+    client.member_context = True
+    client._session_id = "devin-session-1"
+    client._confirmed_capability_session = None
+    client._loaded_capability_template = ""
+    client._capability_projection_gaps = ()
+    return client
+
+
+def test_devin_can_be_selected_and_saved_for_a_bot_and_worker(monkeypatch):
+    monkeypatch.setattr(
+        "kiro_crew.agent_sdk.backends.selectable_backends", lambda: frozenset({"devin"})
+    )
+    config = KiroCrewConfig()
+    assert crewmate_harnesses(config) == ["devin"]
+    assert worker_harnesses(config) == ["devin"]
+    assert harness_pin_rejected("devin", config) is None
+    assert member_backend_gap("devin", ()) is None
+    assert member_backend_gap("devin", ("docs",)) == "tool_limits_unsupported"
+
+
+@pytest.mark.parametrize("edit", [False, True])
+def test_saved_projection_is_confirmed_and_an_unsaved_edit_is_refused(
+    agents_dir_fixture, tmp_path, monkeypatch, edit
+):
+    path = agents_dir_fixture / "kirocrew.json"
+    spec = json.loads(path.read_text(encoding="utf-8"))
+    monkeypatch.setattr(agent_state, "get_capabilities", lambda _: {"materialized": _digest(spec)})
+    if edit:
+        path.write_text(json.dumps({**spec, "description": "unsaved edit"}), encoding="utf-8")
+    client = _saved_client(tmp_path)
+    client._resolve_session_mcp_servers()
+    if edit:
+        with pytest.raises(AcpError, match="capability_runtime_unverified"):
+            asyncio.run(client.confirm_member_projection())
+        assert client._loaded_capability_template == ""
+    else:
+        asyncio.run(client.confirm_member_projection())
+        assert client._loaded_capability_template == "kirocrew"
+        assert client._confirmed_capability_session == "devin-session-1"
+
+
+def test_the_consumed_projection_is_checked_even_if_the_file_changes_later(
+    agents_dir_fixture, tmp_path, monkeypatch
+):
+    path = agents_dir_fixture / "kirocrew.json"
+    saved = json.loads(path.read_text(encoding="utf-8"))
+    monkeypatch.setattr(agent_state, "get_capabilities", lambda _: {"materialized": _digest(saved)})
+    client = _saved_client(tmp_path)
+    client._resolve_session_mcp_servers()
+    path.write_text("{}", encoding="utf-8")
+    asyncio.run(client.confirm_member_projection())
+    assert client._loaded_capability_template == "kirocrew"
+
+
+def test_devin_projects_the_workers_member_spec(pixel_worker_fixture):
+    from kiro_crew.mate_worker import MATE_WORKER_AGENT
+    from kiro_crew.providers.mirrors import mirror_for
+
+    projection = mirror_for("devin").session_projection(
+        MATE_WORKER_AGENT, session_key="dashboard:chat-9"
+    )
+    assert "jira" in {s["name"] for s in projection.params["mcpServers"]}
