+"""Devin's managed MCP children redeem IPC credentials before serving tools."""
+
+from __future__ import annotations
+
+import importlib
+import sys
+from pathlib import Path
+from typing import Any
+
+if __name__ == "__main__" and not __package__:
+    # Native MCP launchers may clear PYTHONPATH. Import the package beside this
+    # trusted entry script instead of an unrelated installed checkout.
+    sys.path.insert(0, str(Path(__file__).resolve().parents[3]))
+
+from kiro_crew.platform_compat import isolated_python_argv
+
+# Only host-derived control-plane entries can receive a session credential.
+# The wrapper calls the ordinary server in the redeeming process: a subprocess
+# would lose both the in-memory credential and its kernel peer identity.
+_ENTRY_POINTS = {
+    "kirocrew-core": ("kiro_crew.mcp_core", "run_mcp_core_server"),
+    "kirocrew-cron": ("kiro_crew.mcp_cron", "run_mcp_server"),
+    "kirocrew-dashboard": ("kiro_crew.mcp_dashboard", "run_mcp_server"),
+    "kirocrew-panel": ("kiro_crew.mcp_panel", "run_mcp_server"),
+}
+
+
+def prepare_servers(servers: list[dict[str, Any]]) -> tuple[list[dict[str, Any]], frozenset[str]]:
+    """Use Crew's own entry point for each trusted managed name, never a spec command."""
+    out = []
+    for element in servers:
+        name = element.get("name")
+        if name in _ENTRY_POINTS:
+            argv = isolated_python_argv(str(Path(__file__).resolve()), name)
+            element = {**element, "command": argv[0], "args": argv[1:]}
+        out.append(element)
+    return out, frozenset(_ENTRY_POINTS)
+
+
+def main() -> None:
+    if len(sys.argv) != 2 or sys.argv[1] not in _ENTRY_POINTS:
+        raise SystemExit("Expected a managed Devin MCP server name")
+    from kiro_crew.agent_ipc_client import redeem_at_startup
+    from kiro_crew.mcp_core_parts.gateway import _api_port
+
+    redeem_at_startup(_api_port)
+    module, function = _ENTRY_POINTS[sys.argv[1]]
+    getattr(importlib.import_module(module), function)()
+
+
+if __name__ == "__main__":
+    main()
